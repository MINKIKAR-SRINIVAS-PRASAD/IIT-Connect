# Server
NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Mongo - set your own connection string locally; never commit real credentials
MONGO_URI=mongodb://localhost:27017/iitconnect

# Auth
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=60d

# Admin
# Comma-separated emails that become admins at login/register
ADMIN_EMAILS=admin@iitbbs.ac.in

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=40
