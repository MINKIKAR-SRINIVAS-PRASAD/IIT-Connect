# Copy to .env locally or configure these values in your hosting provider.
# Never commit a real .env file or production secrets.

# Server
NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# MongoDB - replace with your own connection string
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth - generate two different random secrets, each at least 32 characters
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin provisioning - do not put an admin email here unless the account is
# created through a trusted provisioning process. Configured admin emails
# are blocked from public self-registration.
ADMIN_EMAILS=admin@iitbbs.ac.in
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=40
