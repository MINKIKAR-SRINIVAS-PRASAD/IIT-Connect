# Server
NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — use your private database URI locally and in your hosting environment.
# Never commit real credentials to GitHub.
MONGO_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth — generate strong, unique secrets for each environment.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin — comma-separated admin email addresses
ADMIN_EMAILS=

# Faculty — exact, approved faculty email addresses only (comma-separated).
# Do not use the full institute domain, as it would grant faculty access to students.
# Add the institution-approved addresses here and to the backend hosting environment.
FACULTY_EMAILS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=40
